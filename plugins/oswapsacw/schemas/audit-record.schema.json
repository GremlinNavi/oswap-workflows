{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oswap.ca/schemas/oswapsacw/audit-record.schema.json",
  "title": "OSWAPSACW Audit Record",
  "type": "object",
  "required": ["oswapsacw_version", "operation_id", "request", "authorization", "execution", "verification"],
  "properties": {
    "oswapsacw_version": {"type": "string"},
    "operation_id": {"type": "string", "minLength": 1},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "request": {
      "type": "object",
      "required": ["summary", "canonical_operation"],
      "properties": {
        "summary": {"type": "string"},
        "canonical_operation": {"type": "string"},
        "action_class": {
          "enum": ["read_only", "local_write", "remote_write", "destructive"]
        }
      }
    },
    "proposal": {
      "type": "object",
      "properties": {
        "targets": {"type": "array", "items": {"type": "string"}},
        "side_effects": {"type": "array", "items": {"type": "string"}},
        "data_exposure": {"type": "array", "items": {"type": "string"}},
        "reversible": {"type": "boolean"},
        "rollback_plan": {"type": "string"}
      }
    },
    "authorization": {
      "type": "object",
      "required": ["required", "status", "scope"],
      "properties": {
        "required": {"type": "boolean"},
        "status": {"enum": ["not_required", "approved", "denied", "cancelled", "missing"]},
        "scope": {"type": "string"},
        "expires_after_operation": {"type": "boolean"}
      }
    },
    "execution": {
      "type": "object",
      "required": ["tools_used", "actions"],
      "properties": {
        "tools_used": {"type": "array", "items": {"type": "string"}},
        "actions": {"type": "array", "items": {"type": "string"}},
        "changed_artifacts": {"type": "array", "items": {"type": "string"}}
      }
    },
    "epistemic": {
      "type": "object",
      "description": "Optional LLM epistemic-guardrail record separating generative claims from independently inspectable evidence.",
      "properties": {
        "models_used": {
          "type": "array",
          "items": {"type": "string"}
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["claim", "status"],
            "properties": {
              "claim": {"type": "string", "minLength": 1},
              "status": {
                "enum": ["proposed", "supported", "rejected", "partially_verified", "unverified", "inconclusive"]
              },
              "evidence_refs": {
                "type": "array",
                "items": {"type": "string"}
              }
            },
            "additionalProperties": true
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["class", "source"],
            "properties": {
              "class": {"enum": ["E0", "E1", "E2", "E3"]},
              "source": {"type": "string", "minLength": 1},
              "result": {"type": "string"},
              "provenance": {"type": "string"}
            },
            "additionalProperties": true
          }
        },
        "deterministic_checks": {
          "type": "array",
          "items": {"type": "string"}
        },
        "evaluator_independence": {
          "enum": ["independent_model_or_human", "same_model_separate_pass", "deterministic_tool", "mixed", "not_applicable", "unknown"]
        },
        "human_decision": {
          "enum": ["accepted", "rejected", "revision_requested", "not_yet_decided", "not_applicable"]
        },
        "residual_uncertainty": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": true
    },
    "validation": {"type": "object"},
    "verification": {"type": "object"},
    "errors": {"type": "array", "items": {"type": "string"}},
    "unresolved_gaps": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
